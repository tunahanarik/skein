# Phase 0 needs no secrets and no private keys. Never put a private key here.

# Robinhood Chain RPC. The public endpoint is rate-limited and officially "not for production"
# (docs.robinhood.com/chain/connecting). For anything beyond validation scripts, use a keyed
# provider URL (Alchemy / QuickNode / Chainstack, all listed in the official docs).
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# APP_ENV=production refuses the public RPC above; set a dedicated provider URL instead.
# APP_ENV=development

# Optional RPC tuning (defaults in src/chain/rpcConfig.ts)
# RPC_MULTICALL_CHUNK_SIZE=400
# RPC_MAX_ATTEMPTS=4
# RPC_TIMEOUT_MS=20000
# RPC_RETRY_BASE_MS=600

# Optional public wallets for `pnpm validate:portfolio` (comma-separated). If unset, recent
# public holders are discovered from Transfer logs. Reports only ever show a hash.
# PORTFOLIO_TEST_WALLETS=
