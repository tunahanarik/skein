# Phase 0 needs no secrets and no private keys. Never put a private key here.

# Robinhood Chain RPC. The public endpoint is rate-limited and officially "not for production"
# (docs.robinhood.com/chain/connecting). For anything beyond validation scripts, use a keyed
# provider URL (Alchemy / QuickNode / Chainstack, all listed in the official docs).
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# APP_ENV=production REQUIRES ROBINHOOD_RPC_URL to be set to a dedicated provider and refuses the
# public RPC (the process fails at startup with a clear error). No provider is hardcoded.
# APP_ENV=development

# Optional separate endpoint for eth_getLogs indexing (pool/market discovery), e.g. an archive- or
# indexing-capable plan. Defaults to ROBINHOOD_RPC_URL. Must be https; never the public RPC in
# production. Keyed URLs contain secrets: keep them in .env (gitignored), never in code or docs.
# ROBINHOOD_INDEX_RPC_URL=

# Minimum spacing between eth_getLogs requests (ms). Defaults: 1000 on the public RPC, 0 otherwise.
# RPC_LOG_MIN_INTERVAL_MS=

# Optional RPC tuning (defaults in src/chain/rpcConfig.ts)
# RPC_MULTICALL_CHUNK_SIZE=400
# RPC_MAX_ATTEMPTS=4
# RPC_TIMEOUT_MS=20000
# RPC_RETRY_BASE_MS=600

# Optional public wallets for `pnpm validate:portfolio` (comma-separated). If unset, recent
# public holders are discovered from Transfer logs. Reports only ever show a hash.
# PORTFOLIO_TEST_WALLETS=
