{
  "name": "skein",
  "private": true,
  "version": "0.0.0",
  "description": "Onchain intelligence for Robinhood Chain: wallets, Stock Tokens, protocol positions and opportunities, every number with its source.",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web",
    "test": "vitest run",
    "test:unit": "vitest run packages apps",
    "test:integration": "vitest run test/integration",
    "check:deps": "node tools/check-deps.mjs",
    "check": "pnpm check:deps && pnpm typecheck && pnpm test",
    "validate": "tsx apps/cli/src/validate-all.ts",
    "validate:network": "tsx apps/cli/src/validate-network.ts",
    "validate:assets": "tsx apps/cli/src/validate-assets.ts",
    "validate:oracles": "tsx apps/cli/src/validate-oracles.ts",
    "validate:morpho": "tsx apps/cli/src/validate-morpho.ts",
    "validate:pendle": "tsx apps/cli/src/validate-pendle-adapter.ts",
    "validate:pendle:research": "tsx apps/cli/src/validate-pendle.ts",
    "validate:portfolio": "tsx apps/cli/src/validate-portfolio.ts",
    "registry:snapshot": "tsx apps/cli/src/registry-snapshot.ts",
    "registry:check": "tsx apps/cli/src/registry-snapshot.ts --check",
    "portfolio": "tsx apps/cli/src/portfolio.ts",
    "validate:opportunities": "tsx apps/cli/src/validate-opportunities.ts",
    "opportunities": "tsx apps/cli/src/opportunities.ts",
    "trade:inspect": "tsx apps/cli/src/trade-inspect.ts",
    "uniswap:index": "tsx apps/cli/src/uniswap-index.ts",
    "validate:uniswap": "tsx apps/cli/src/validate-uniswap.ts",
    "validate:pairs": "tsx apps/cli/src/validate-pairs.ts",
    "asset": "tsx apps/cli/src/asset.ts",
    "portfolio:view": "tsx apps/cli/src/portfolio-view.ts",
    "coverage": "tsx apps/cli/src/coverage.ts",
    "validate:intelligence": "tsx apps/cli/src/validate-intelligence.ts",
    "serve": "tsx apps/server/src/main.ts",
    "web:dev": "vite --config apps/web/vite.config.ts",
    "web:build": "vite build --config apps/web/vite.config.ts",
    "web:snapshot": "vite build --config apps/web/snapshot/vite.config.ts",
    "web:typecheck": "tsc --noEmit -p apps/web",
    "start": "pnpm web:build && pnpm serve"
  },
  "devDependencies": {
    "@skein/chain": "workspace:*",
    "@skein/cli": "workspace:*",
    "@skein/core": "workspace:*",
    "@skein/engine": "workspace:*",
    "@skein/networks": "workspace:*",
    "@skein/portfolio": "workspace:*",
    "@skein/pricing": "workspace:*",
    "@skein/product": "workspace:*",
    "@skein/protocols": "workspace:*",
    "@skein/robinhood": "workspace:*",
    "@skein/runtime": "workspace:*",
    "@skein/server": "workspace:*",
    "@skein/testkit": "workspace:*",
    "@skein/web": "workspace:*",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "viem": "2.56.8",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "zod": "4.6.5"
  }
}
