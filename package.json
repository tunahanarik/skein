{
  "name": "defi-router",
  "private": true,
  "version": "0.0.0",
  "description": "Read-only DeFi opportunity discovery for Robinhood Chain assets (Morpho + Pendle; no execution).",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "validate": "tsx scripts/validate-all.ts",
    "validate:network": "tsx scripts/validate-network.ts",
    "validate:assets": "tsx scripts/validate-assets.ts",
    "validate:oracles": "tsx scripts/validate-oracles.ts",
    "validate:morpho": "tsx scripts/validate-morpho.ts",
    "validate:pendle": "tsx scripts/validate-pendle-adapter.ts",
    "validate:pendle:research": "tsx scripts/validate-pendle.ts",
    "validate:portfolio": "tsx scripts/validate-portfolio.ts",
    "registry:snapshot": "tsx scripts/registry-snapshot.ts",
    "registry:check": "tsx scripts/registry-snapshot.ts --check",
    "portfolio": "tsx scripts/portfolio.ts",
    "validate:opportunities": "tsx scripts/validate-opportunities.ts",
    "opportunities": "tsx scripts/opportunities.ts",
    "trade:inspect": "tsx scripts/trade-inspect.ts",
    "uniswap:index": "tsx scripts/uniswap-index.ts",
    "validate:uniswap": "tsx scripts/validate-uniswap.ts",
    "asset": "tsx scripts/asset.ts",
    "portfolio:view": "tsx scripts/portfolio-view.ts",
    "coverage": "tsx scripts/coverage.ts",
    "validate:intelligence": "tsx scripts/validate-intelligence.ts"
  },
  "dependencies": {
    "viem": "2.56.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
